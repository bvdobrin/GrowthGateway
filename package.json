{
  "name": "growthgateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GrowthGateway: Comms & Growth digital asset management middleware MVP",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "tokens:build": "node style-dictionary.config.mjs",
    "predev": "npm run tokens:build",
    "dev": "vite",
    "prebuild": "npm run tokens:build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
